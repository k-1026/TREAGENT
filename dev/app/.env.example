# Supabase 대시보드 > Project Settings > API 에서 복사합니다.
# 이 파일을 .env로 복사해 값을 채웁니다. .env는 커밋하지 않습니다.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# 서버(dev/server) 주소. 휴대폰이 접속하므로 localhost가 아니라 서버를 켠 컴퓨터의 Wi-Fi IP를 씁니다.
# 서버를 켜면 터미널에 "휴대폰에서 확인: http://<IP>:3000/health"로 주소가 나옵니다.
# 비밀 값은 넣지 않습니다 (EXPO_PUBLIC_ 값은 앱에 그대로 들어갑니다).
EXPO_PUBLIC_SERVER_URL=http://192.168.0.10:3000
