# Supabase 대시보드 > Project Settings > API 에서 복사합니다.
# 이 파일을 .env로 복사해 값을 채웁니다. .env는 커밋하지 않습니다.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# 서버(dev/server) 주소. 배포된 Railway 서버를 씁니다. 끝에 /나 포트를 붙이지 않습니다.
# 서버를 내 컴퓨터에서 직접 띄울 때만 바꿉니다. 같은 컴퓨터 웹은 http://localhost:3000, 휴대폰은 서버 컴퓨터의 Wi-Fi IP(http://<IP>:3000)입니다.
# 비밀 값은 넣지 않습니다 (EXPO_PUBLIC_ 값은 앱에 그대로 들어갑니다). 바꾼 뒤에는 npx expo start -c로 다시 시작합니다.
EXPO_PUBLIC_SERVER_URL=https://treagent-production.up.railway.app
