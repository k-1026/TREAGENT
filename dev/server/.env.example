# 이 파일을 .env로 복사해 값을 채웁니다. .env는 커밋하지 않습니다.
# 비밀 값(키, 비밀번호)은 채팅, GitHub, 스크린샷에 올리지 않습니다.

# 서버 포트 (비워 두면 3000)
PORT=3000

# 개발용 CORS: 웹 브라우저(Expo web)로 앱을 확인할 때만 그 주소를 적습니다 (예: http://localhost:8081).
# 비워 두면 아무 곳도 허용하지 않습니다. 휴대폰 앱에는 필요 없습니다. 비밀 값이 아닙니다.
CORS_ORIGIN=

# 날씨 데이터 출처: kma(기상청 실제 호출) 또는 mock(가짜 데이터). 날씨 어댑터부터 사용.
WEATHER_SOURCE=mock
WEATHER_MOCK_SCENARIO=ok

# 기상청 공공데이터 인증키. 날씨 어댑터부터 사용.
KMA_SERVICE_KEY=

# 아래 3개는 DB를 쓰는 PR부터 사용합니다 (지금은 쓰지 않음).
# Supabase 대시보드 > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# service role 키는 서버 전용입니다. 앱(dev/app)에는 절대 넣지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase 대시보드 > Project Settings > Database > Connection string
DATABASE_URL=

GOOGLE_API_KEY=
GEMINI_MODEL=