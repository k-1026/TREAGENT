# 이 파일을 .env로 복사해 값을 채웁니다. .env는 커밋하지 않습니다.
# 비밀 값(키, 비밀번호)은 채팅, GitHub, 스크린샷에 올리지 않습니다.

# 서버 포트 (비워 두면 3000)
PORT=3000

# 개발용 CORS: 웹 브라우저(Expo web)로 앱을 확인할 때만 그 주소를 적습니다 (예: http://localhost:8081).
# 비워 두면 아무 곳도 허용하지 않습니다. 휴대폰 앱에는 필요 없습니다. 비밀 값이 아닙니다.
CORS_ORIGIN=

# 날씨 데이터 출처: kma(기상청 실제 호출) 또는 mock(가짜 데이터). 날씨 어댑터부터 사용.
WEATHER_SOURCE=mock
WEATHER_MOCK_SCENARIO=ok

# 기상청 공공데이터 인증키. 날씨 어댑터부터 사용.
KMA_SERVICE_KEY=

# 아래 3개는 DB를 쓰는 PR부터 사용합니다 (지금은 쓰지 않음).
# Supabase 대시보드 > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# service role 키는 서버 전용입니다. 앱(dev/app)에는 절대 넣지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase 대시보드 > Project Settings > Database > Connection string
DATABASE_URL=

GOOGLE_API_KEY=
GEMINI_MODEL=

# TMAP(SK OPEN API) 앱키. 도보 길찾기 경로를 서버가 호출할 때만 씁니다 (아직 코드에서 쓰지 않음).
# openapi.sk.com에서 가입 후 TMAP 상품(무료사용)을 신청하면 발급됩니다. 팀 대표 1명만 신청합니다.
# 서버 전용입니다. 앱(dev/app)과 EXPO_PUBLIC_ 값에는 넣지 않습니다.
TMAP_APP_KEY=

# 관리자 확인 화면(/admin). 아이디·비밀번호 로그인이고, 앱 이용자(Supabase) 계정과 따로입니다. 비워 두면 /admin은 닫혀 있습니다 (503).
# 값 3개는 `node scripts/make_admin_account.js`를 실행하면 만들어 줍니다. 비밀 값이니 GitHub에 올리지 않습니다.
# ADMIN_PASSWORD_HASH는 비밀번호 원문이 아니라 해시입니다. ADMIN_SESSION_SECRET은 32자 이상이어야 합니다.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# ADMIN_DEV_OPEN=true: 내 컴퓨터(localhost)에서 화면을 확인할 때만 로그인 없이 엽니다. 배포 환경(Railway)에는 넣지 않습니다.
ADMIN_DEV_OPEN=
# RUN_KEY_SECRET: 실행 기록에서 이용자를 가리킬 해시 키를 만드는 비밀값입니다. 아직 코드에서 쓰지 않습니다. 바꾸면 이전 기록과의 연결이 끊어집니다.
RUN_KEY_SECRET=